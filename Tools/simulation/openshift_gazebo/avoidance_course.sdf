<?xml version="1.0"?>
<sdf version="1.9">
  <world name="avoidance_course">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <scene>
      <ambient>0.7 0.7 0.7 1</ambient>
      <background>0.6 0.8 1 1</background>
      <shadows>false</shadows>
    </scene>
    <light name="sun" type="directional">
      <direction>-0.5 0.2 -1</direction>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <cast_shadows>false</cast_shadows>
    </light>
    <model name="ground">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <material><ambient>0.3 0.5 0.3 1</ambient></material>
        </visual>
      </link>
    </model>
    <!-- ENU coordinates: a wall 15 m east of spawn, extending to 6 m high. -->
    <model name="east_wall">
      <static>true</static>
      <pose>15 0 3 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1 20 6</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1 20 6</size></box></geometry>
          <material><ambient>0.8 0.3 0.1 1</ambient></material>
        </visual>
      </link>
    </model>
    <model name="north_building">
      <static>true</static>
      <pose>0 20 4 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>10 8 8</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>10 8 8</size></box></geometry>
          <material><ambient>0.2 0.4 0.8 1</ambient></material>
        </visual>
      </link>
    </model>
    <!-- Keep the same geographic origin as Baylands; this geometry is a
         synthetic course and does not correspond to QGC satellite imagery. -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>37.412173071650805</latitude_deg>
      <longitude_deg>-121.998878727967</longitude_deg>
      <elevation>38</elevation>
    </spherical_coordinates>
  </world>
</sdf>
